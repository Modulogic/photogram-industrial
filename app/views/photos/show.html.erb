<p style="color: green"><%= notice %></p>

<%= render @photo %>

<div>
  <%= link_to edit_photo_path(@photo), class: "fa-edit" do %>
    <i class="fa fa-edit"></i>
  <% end %>
  <%= link_to photos_path do %>
    Back to photos
  <% end %>
  <%= link_to @photo, method: :delete, data: { confirm: "Are you sure?" }, class: "fa-trash" do %>
    <i class="fa fa-trash"></i>
  <% end %>
</div>
